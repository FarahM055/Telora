# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never commit real keys.

# --- OpenAI (required) ---
OPENAI_API_KEY=your-openai-api-key

# Models (optional; these are the defaults)
# Search planning/assessment, Solution Design planning, quality check, recommendation
OPENAI_MODEL=gpt-4o-mini
# Search Agent runtime Judge
JUDGE_MODEL=gpt-5.6-terra
# Solution Design tool-calling loop
DESIGN_MODEL=gpt-5.6-terra
# Optional semantic graders for offline evaluation
# EVALUATION_MODEL=gpt-4o-mini

# --- LangSmith tracing & evaluation (optional) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=TELORA
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Environment label recorded on traces
TELORA_ENVIRONMENT=development
